# ---------------------------------------------------------------------------
# Notes Etc bootstrap configuration.
# Only what's needed to START lives here; ongoing config is managed in-app.
# Copy to .env and adjust. NEVER commit a real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# --- Database -------------------------------------------------------------
# POC (Postgres). Matches docker-compose `db` service.
DATABASE_URL=postgresql://notesetc:notesetc@localhost:5432/notesetc?schema=public
# Production (MSSQL) example:
# DATABASE_URL=sqlserver://HOST:1433;database=notesetc;user=sa;password=...;encrypt=true;trustServerCertificate=true

# --- Secrets (required in production) -------------------------------------
# 32-byte key, base64 or hex. Encrypts sensitive settings at rest (AES-256-GCM).
MASTER_ENCRYPTION_KEY=
# Signs web session cookies.
SESSION_SECRET=

# --- Breakglass local admin ----------------------------------------------
# If BREAKGLASS_ADMIN_EMAIL is REMOVED, the breakglass account is DISABLED on boot.
BREAKGLASS_ADMIN_EMAIL=admin@example.com
# Provide ONE of the following. A pre-computed hash is preferred for production.
BREAKGLASS_ADMIN_PASSWORD=change-me-please-12+
# BREAKGLASS_ADMIN_PASSWORD_HASH=
